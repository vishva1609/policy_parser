{
  "info": {
    "name": "File Parsing QA API",
    "description": "Mirrors archit1012/qa-bot-llm POST /upload — document + questions JSON, RAG answers via Mistral.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Compare policies (FastAPI :8000)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "policy_a",
              "type": "file",
              "src": []
            },
            {
              "key": "policy_b",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{fastapi_url}}/compare/policies"
      }
    },
    {
      "name": "FastAPI health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{fastapi_url}}/health"
      }
    },
    {
      "name": "Upload doc + questions",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "doc_file",
              "type": "file",
              "src": []
            },
            {
              "key": "question_file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{base_url}}/upload"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "fastapi_url",
      "value": "http://localhost:8000"
    }
  ]
}
